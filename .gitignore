# 忽略编辑器配置目录
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.atom/
.eclipse/
*.swp
*.swo
*~

# 忽略 python 目录和相关文件
python/
__pycache__/
*.py[cod]
*$py.class
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 忽略依赖目录
node_modules/
bower_components/
jspm_packages/
vendor/

# 忽略日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略环境文件
.env
.env.local
.env.development
.env.test
.env.production
.env*.local

# 忽略操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 忽略构建输出目录
dist/
build/
out/
target/
Release/
Debug/

# 忽略临时文件
tmp/
temp/
.tmp/
